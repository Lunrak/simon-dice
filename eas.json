{
	"cli": {
		"version": ">= 24.11.0",
		"appVersionSource": "remote",
		"requireCommit": true
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"android": {
				"buildType": "app-bundle"
			},
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {}
	}
}
